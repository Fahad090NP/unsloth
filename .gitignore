/datasets/
feature/
outputs/
exports/
resources/
tmp/
temp/
logs/
out/
unsloth_compiled_cache/
unsloth_training_checkpoints/
llama.cpp/
*.gguf
*.safetensors
scripts/data/pypi_cache/
