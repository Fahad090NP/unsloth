docker/jupyter/unsloth_labext/node_modules/
docker/jupyter/unsloth_labext/lib/
docker/jupyter/unsloth_labext/*.tsbuildinfo
docker/jupyter/unsloth_labext/unsloth-jupyterlab/
docker/jupyter/unsloth_labext/.yarn/
docker/jupyter/unsloth_labext/.pnp.*

