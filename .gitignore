# Repository-wide ignore rules.
# One file owns every path; nested .gitignore files are not used.
# Patterns are grouped by ecosystem so a new ignore belongs to exactly one section.

# ---------------------------------------------------------------------------
# Operating systems and editors
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/
.claude/
.omx/
.pypirc

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.class
.Python
*.so
*.mo
*.pot
*.sage.py
cython_debug/
.ipynb_checkpoints/
profile_default/
ipython_config.py

# Packaging and build output
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
.pybuilder/
target/

# Environments
.env
.env.*
!.env.example
.venv/
.venv_overlay/
.venv_t5/
env/
venv/
ENV/
env.bak/
venv.bak/
environment.yaml

# Tool caches and reports
.cache/
.coverage
.coverage.*
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.pre-commit-cache/
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
cover/
.pdm.toml
.pdm-python
.pdm-build/
__pypackages__/
celerybeat-schedule
celerybeat.pid
instance/
.webassets-cache
.scrapy/
.spyderproject
.spyproject
.ropeproject

# Installer and service output
pip-log.txt
pip-delete-this-directory.txt
local_settings.py
db.sqlite3
db.sqlite3-journal
firebase-debug.log
server.pid
*.log
log.txt
log_rtx.txt
setup_leo.sh

# Python documentation
docs/_build/
/site

# ---------------------------------------------------------------------------
# JavaScript, TypeScript and the frontend
# ---------------------------------------------------------------------------
**/node_modules/
.eslintcache
*.tsbuildinfo
*.local
dist-ssr/

# Frontend build, environment and editor output
studio/frontend/logs/
studio/frontend/dist/
studio/frontend/dist-ssr/
studio/frontend/test/
studio/frontend/*.local
studio/frontend/.env
studio/frontend/.env.*
studio/frontend/.omx/
studio/frontend/.vscode/*
!studio/frontend/.vscode/extensions.json
studio/frontend/.idea/
studio/frontend/docs/
studio/frontend/src/features/recipe-studio/AGENTS.md

# Stray lockfiles; real npm projects opt back in so `npm ci` stays reproducible.
# `bun.lock` is intentionally tracked for the Bun workflow.
package-lock.json
!studio/frontend/package-lock.json
!studio/backend/core/data_recipe/oxc-validator/package-lock.json
!studio/package-lock.json

